# Server-side only. Never expose these values to the browser or commit a populated .env file.

# --- Public address of this backend (used for the Google OAuth redirect URI) ---
AI_FACTORY_PUBLIC_URL=http://127.0.0.1:8000
# Web consoles allowed to call this backend with credentials (comma separated, no trailing slash).
AI_FACTORY_ALLOWED_ORIGINS=https://thstjdals09-lang.github.io,http://127.0.0.1:8000

# --- Google login (Google Cloud Console → OAuth client, type "Web application") ---
# Authorized redirect URI: <AI_FACTORY_PUBLIC_URL>/auth/google/callback
AI_FACTORY_GOOGLE_CLIENT_ID=
AI_FACTORY_GOOGLE_CLIENT_SECRET=

# --- Encrypted secret vault. Generate once and keep it safe:
#   python -c "from app.vault import generate_key; print(generate_key())"
# Losing this key makes stored provider credentials unreadable.
AI_FACTORY_VAULT_KEY=

# --- Session cookie. Cross-site use from GitHub Pages needs HTTPS + SameSite=None.
AI_FACTORY_COOKIE_SECURE=true
AI_FACTORY_COOKIE_SAMESITE=none
AI_FACTORY_SESSION_DAYS=14

# Local development only: enables POST /auth/dev-login. Never enable on a public server.
AI_FACTORY_DEV_LOGIN=false

# --- Storage ---
AI_FACTORY_DB=data/ai_factory.sqlite3
AI_FACTORY_WORKSPACE=data/workspaces

# --- GitHub publishing (optional) ---
AI_FACTORY_GITHUB_TOKEN=
# Defaults to the authenticated GitHub user; may also be an organization login.
AI_FACTORY_GITHUB_OWNER=thstjdals09-lang
